# OpenAI-compatible API for the GPT Image 2 still engine (required only if you
# select GPT Image 2; the Krea-2 engine runs fully local via ComfyUI).
# Copy this file to .env and fill in your own values. Never commit .env.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=gpt-image-2

# Still image quality: high | medium | low (cost control for probes)
OPENAI_IMAGE_QUALITY=high

# Optional stream tuning (stream is OFF by default; non-stream is the primary path)
# GPT2_STREAM_SILENCE_MS=180000

# Remote ComfyUI mode: set COMFY_REMOTE=1 when this app runs on a different
# machine than ComfyUI. Inputs are staged via POST /upload/image and outputs
# fetched via GET /view (COMFY_URL must point at the remote host). Note:
# ComfyUI has no delete API, so online_temp files accumulate on the ComfyUI
# host and should be cleaned there occasionally.
# COMFY_URL=http://192.168.1.100:8188
# COMFY_REMOTE=1
